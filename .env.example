# Optional: enables AI-generated blueprints for industries not in the curated database
OPENAI_API_KEY=
# Optional: defaults to gpt-4o-mini
OPENAI_MODEL=
# Required for the /admin panel (industry CRUD, audit log, credits)
ADMIN_ACCESS_CODE=
# Set to "true" to enforce pay-per-blueprint: requests without a valid access code get a preview only
BILLING_ENABLED=
# Optional: directory for the SQLite database (defaults to ./data)
DATA_DIR=
# Optional: SMTP for email notifications (quote alerts to you, credit confirmations to clients)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM=
# Where new-quote notifications are sent
NOTIFY_EMAIL=
